{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maheer-cloudflare",
  "main": "./worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
